# Configuración local segura para desarrollo.
# Este archivo puede versionarse. Copia a .env.local para personalizar.
APP_ENV=local
SESSION_SECRET=local-development-secret-change-before-sharing
SESSION_HTTPS_ONLY=false
PUBLIC_BASE_URL=http://127.0.0.1:8765
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SEED_DEMO=true
OPEN_BROWSER=1
HOST=127.0.0.1
PORT=8765
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=12
SLOW_REQUEST_SECONDS=1.0
METRICS_MAX_SERIES=1000
STORAGE_BACKEND=local
EMAIL_BACKEND=file
PAYMENT_BACKEND=demo
SCHEDULER_ENABLED=false
CSRF_ENABLED=true
STRUCTURED_LOGGING=true
AUDIT_CHAIN_ENABLED=true
DEPLOYMENT_STRICT=false
