# Entorno: local | staging | production
APP_ENV=production

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO
SESSION_HTTPS_ONLY=true

# PostgreSQL
DATABASE_URL=postgresql+psycopg://calculatuhuella:CAMBIAR_PASSWORD@postgres:5432/calculatuhuella
POSTGRES_DB=calculatuhuella
POSTGRES_USER=calculatuhuella
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Publicación
PUBLIC_BASE_URL=https://huella.ejemplo.com
TRUSTED_HOSTS=huella.ejemplo.com,localhost,127.0.0.1
DOMAIN=huella.ejemplo.com

# Inicialización segura
SEED_DEMO=false
BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
BOOTSTRAP_ORGANIZATION="Empresa Ejemplo S.A.S."

# Operación
MAX_UPLOAD_MB=25
BACKUP_RETENTION=14
WEB_CONCURRENCY=2
PORT=8765

# Almacenamiento: local | filesystem | s3
STORAGE_BACKEND=filesystem
EXTERNAL_STORAGE_ROOT=/var/lib/calcula-tu-huella/documentos
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Notificaciones por correo: file | smtp | disabled
EMAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Calcula tu Huella <noreply@ejemplo.com>"
SMTP_TLS=true
NOTIFICATION_BATCH_SIZE=50

# Automatizaciones programadas
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Pagos
PAYMENT_BACKEND=demo
PAYMENT_WEBHOOK_SECRET=

# Seguridad V0.25
CSRF_ENABLED=true
STRUCTURED_LOGGING=true
AUDIT_CHAIN_ENABLED=true

# Observabilidad y puerta productiva
METRICS_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO
ALERT_WEBHOOK_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO
ALERT_ORGANIZATION_ID=1
DEPLOYMENT_STRICT=true

# Salud de servicios externos para certificación estricta
OBJECT_STORAGE_HEALTH_URL=http://minio:9000/minio/health/ready
PROMETHEUS_HEALTH_URL=http://prometheus:9090/-/ready
ALERTMANAGER_HEALTH_URL=http://alertmanager:9093/-/ready
GRAFANA_HEALTH_URL=http://grafana:3000/api/health
EXTERNAL_PROBE_TIMEOUT_SECONDS=5
