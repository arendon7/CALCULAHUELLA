# Entorno: local | staging | production
APP_ENV=production

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO
SESSION_HTTPS_ONLY=true

# PostgreSQL
DATABASE_URL=postgresql+psycopg://calculatuhuella:CAMBIAR_PASSWORD@postgres:5432/calculatuhuella
POSTGRES_DB=calculatuhuella
POSTGRES_USER=calculatuhuella
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Publicación
PUBLIC_BASE_URL=https://huella.ejemplo.com
TRUSTED_HOSTS=huella.ejemplo.com,localhost,127.0.0.1
DOMAIN=huella.ejemplo.com

# Inicialización segura
SEED_DEMO=false
BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
BOOTSTRAP_ORGANIZATION="Empresa Ejemplo S.A.S."

# Operación
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=30
SLOW_REQUEST_SECONDS=1.0
METRICS_MAX_SERIES=1000
BACKUP_RETENTION=14
BACKUP_SIGNING_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_48_BYTES
BACKUP_OFFSITE_ENABLED=true
BACKUP_STORAGE_PREFIX=system-backups
RESTORE_DRILL_MAX_AGE_DAYS=90
OBJECT_STORAGE_VERSIONING_CONFIRMED=true
WEB_CONCURRENCY=2
PORT=8765

# Almacenamiento: local | filesystem | s3
STORAGE_BACKEND=filesystem
EXTERNAL_STORAGE_ROOT=/var/lib/calcula-tu-huella/documentos
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Notificaciones por correo: file | smtp | disabled
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Calcula tu Huella <noreply@ejemplo.com>"
SMTP_TLS=true
NOTIFICATION_BATCH_SIZE=50

# Automatizaciones programadas
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Pagos
PAYMENT_BACKEND=demo
PAYMENT_WEBHOOK_SECRET=

# Seguridad V0.25
CSRF_ENABLED=true
STRUCTURED_LOGGING=true
AUDIT_CHAIN_ENABLED=true

# Observabilidad y puerta productiva
METRICS_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO
ALERT_WEBHOOK_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO
ALERT_ORGANIZATION_ID=1
DEPLOYMENT_STRICT=true

# Salud de servicios externos para certificación estricta
OBJECT_STORAGE_HEALTH_URL=http://minio:9000/minio/health/ready
PROMETHEUS_HEALTH_URL=http://prometheus:9090/-/ready
ALERTMANAGER_HEALTH_URL=http://alertmanager:9093/-/ready
GRAFANA_HEALTH_URL=http://grafana:3000/api/health
EXTERNAL_PROBE_TIMEOUT_SECONDS=5
# Evidencia externa para autorizar V1.0 (false hasta contar con acta o soporte)
RC_GREENATICS_PILOT_APPROVED=false
RC_SECOND_SECTOR_PILOT_APPROVED=false
RC_CARLOS_REVIEW_APPROVED=false
RC_WINDOWS_10_APPROVED=false
RC_WINDOWS_11_APPROVED=false
RC_SECURITY_REVIEW_APPROVED=false
RC_LEGAL_REVIEW_APPROVED=false

# Identidad contractual y canales legales
LEGAL_PROVIDER_NAME="GREENATICS S.A.S."
LEGAL_PROVIDER_NIT=
LEGAL_NOTICE_ADDRESS=
LEGAL_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=2026-08-05

# Objetivos contractuales del servicio cloud
SLA_MONTHLY_AVAILABILITY_TARGET=99.5
SLA_RPO_HOURS=24
SLA_RTO_HOURS=8

# Aprobaciones internas de V1.0 final (no sustituyen evidencia externa)
FINAL_METHODOLOGY_INTERNAL_APPROVED=true
FINAL_LEGAL_INTERNAL_APPROVED=true
FINAL_GREENATICS_INTERNAL_PILOT_APPROVED=true
FINAL_SECOND_SECTOR_INTERNAL_PILOT_APPROVED=true
FINAL_INFRASTRUCTURE_APPROVED=false
